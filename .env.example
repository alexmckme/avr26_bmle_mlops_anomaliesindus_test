# ─────────────────────────────────────────────────────────────
# Configuration MinIO (object store S3 local) — démo MLOps
# Copier ce fichier en `.env` puis ajuster si besoin.
# Docker Compose lit aussi ces variables (voir docker-compose.yml).
# ─────────────────────────────────────────────────────────────

# Endpoint de l'API S3 de MinIO (host:port)
# (port 9100 ici car 9000 est occupé par un kernel Jupyter local)
MINIO_ENDPOINT=localhost:9100

# Identifiants racine MinIO (défauts du serveur local)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# false = http en local ; true = https
MINIO_SECURE=false

# Bucket qui joue le rôle de « base de données d'images »
MINIO_BUCKET=mvtec-ad

# Dossier source (read-only) des images MVTec AD
DATASET_DIR=dataset/raw

# ─────────────────────────────────────────────
# MLflow — backend sqlite + artefacts dans MinIO
# ─────────────────────────────────────────────
# Laisser vide => sqlite:///<racine du projet>/mlflow.db
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT=anomalies-industrielles
# Bucket MinIO où MLflow range les artefacts de modèles
MLFLOW_ARTIFACT_BUCKET=mlflow
# Silencieux : évite le message d'astuce "tracing" à l'import
MLFLOW_DISABLE_AGENT_HINT=1

# ─────────────────────────────────────────────
# Airflow — orchestration (profil `airflow`)
# ─────────────────────────────────────────────
# Cadence du DAG de démonstration `training_pipeline`
# (`* * * * *` = toutes les minutes ; `@daily` pour un rythme plus réaliste)
TRAINING_SCHEDULE=* * * * *

# ─────────────────────────────────────────────
# Docker Compose — profils (services optionnels)
# ─────────────────────────────────────────────
# `airflow` (orchestration) et `monitoring` (prometheus + grafana) sont derrière
# des profils : par défaut, `docker compose up -d` ne lance que le cœur
# (minio, mlflow, api, streamlit).
#
#   COMPOSE_PROFILES=airflow,monitoring   -> `up -d` et `down` couvrent les 7 services
#   COMPOSE_PROFILES=                     -> cœur uniquement
#   (équivalent ponctuel : docker compose --profile '*' up -d)
#
# Intérêt : ne pas imposer ~2 Go d'images et 1 min de démarrage à qui veut
# seulement entraîner/prédire.
COMPOSE_PROFILES=airflow,monitoring
