# ─────────────────────────────────────────────────────────────
# Configuration MinIO (object store S3 local) — démo MLOps
# Copier ce fichier en `.env` puis ajuster si besoin.
# Docker Compose lit aussi ces variables (voir compose.minio.yml).
# ─────────────────────────────────────────────────────────────

# Endpoint de l'API S3 de MinIO (host:port)
# (port 9100 ici car 9000 est occupé par un kernel Jupyter local)
MINIO_ENDPOINT=localhost:9100

# Identifiants racine MinIO (défauts du serveur local)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# false = http en local ; true = https
MINIO_SECURE=false

# Bucket qui joue le rôle de « base de données d'images »
MINIO_BUCKET=mvtec-ad

# Dossier source (read-only) des images MVTec AD
DATASET_DIR=dataset/raw
