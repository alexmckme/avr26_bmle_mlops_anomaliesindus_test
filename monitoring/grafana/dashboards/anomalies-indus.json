{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 10,
      "type": "text",
      "title": "Comment lire ce tableau de bord ?",
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "**Deux niveaux de surveillance, volontairement côte à côte :**\n\n| | Ce qu'on surveille | Question posée |\n|---|---|---|\n| **Service** (1‑3) | débit, latence, erreurs HTTP | *l'API répond-elle bien ?* |\n| **Modèle** (4‑8) | verdicts, score/seuil, AUC du champion, entraînements | *ce qu'elle prédit a-t-il du sens ?* |\n\n`http_*` = métriques HTTP générées par `prometheus-fastapi-instrumentator` · `anomalies_*` = métriques métier de `core/metrics.py`."
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Débit — requêtes/s sur /predict",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{handler=\"/predict\"}[1m]))",
          "legendFormat": "req/s"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Latence p95 — /predict",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{handler=\"/predict\"}[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Erreurs 5xx (5 min)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(http_requests_total{status=\"5xx\"}[5m])) or vector(0)",
          "legendFormat": "erreurs"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "AUC du champion (par catégorie)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 4,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.9 },
              { "color": "green", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "anomalies_champion_auc",
          "legendFormat": "{{category}}",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Prédictions par verdict — le ratio anomalie/normal dérive-t-il ?",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 3,
          "custom": { "fillOpacity": 18, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "anomalies" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "normal" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(anomalies_predictions_total{verdict=\"anomaly\"}[1m]))",
          "legendFormat": "anomalies"
        },
        {
          "refId": "B",
          "expr": "sum(rate(anomalies_predictions_total{verdict=\"normal\"}[1m]))",
          "legendFormat": "normal"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Score / seuil (1.0 = pile le seuil du modèle)",
      "description": "Rapport score:seuil, donc indépendant de l'échelle des scores (Mahalanobis²). Au-dessus de 1, la pièce est déclarée défectueuse. Une remontée lente de la médiane est le signal typique d'une dérive des données.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "custom": { "fillOpacity": 0, "lineWidth": 2, "showPoints": "auto" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "anomalies_prediction_score_ratio",
          "legendFormat": "{{category}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Entraînements cumulés depuis le démarrage (par minute de collecte)",
      "description": "Compteur cumulé : un palier à chaque entraînement, donc visible dès le premier (contrairement à increase(), qui ne voit que les variations et ignore la valeur initiale). Remis à zéro si l'API redémarre.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": { "fillOpacity": 25, "lineWidth": 1, "showPoints": "auto", "drawStyle": "bars" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(anomalies_trainings_total) by (category, status)",
          "legendFormat": "{{category}} — {{status}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Durée moyenne des entraînements (s)",
      "description": "Moyenne calculée sur les compteurs du processus API (_sum / _count) : robuste même avec peu d'entraînements, contrairement à un p95.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(anomalies_training_duration_seconds_sum) by (category) / clamp_min(sum(anomalies_training_duration_seconds_count) by (category), 1)",
          "legendFormat": "{{category}} — moyenne"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Décisions de promotion cumulées (true = promu, false = refusé)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 26 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": { "fillOpacity": 25, "lineWidth": 1, "showPoints": "auto", "drawStyle": "bars" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "true" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "false" },
            "properties": [{ "id": "color", "value": { "fixedColor": "text", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(anomalies_champion_promotions_total) by (category, promoted)",
          "legendFormat": "{{category}} — promu={{promoted}}"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["mlops", "anomalies-indus", "padim"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timezone": "browser",
  "title": "Anomalies Indus — service & modèle",
  "uid": "anomalies-indus",
  "version": 1
}
